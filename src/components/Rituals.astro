---
import { Icon } from "astro-icon/components";
import { tinaField } from "@tinacms/astro/tina-field";
import { useTranslations, localePath } from "../i18n/ui";
import { type Locale } from "../data/site";
import { mediaSrc, present, type RitualsData } from "../lib/tina/data";

interface Props {
  locale: Locale;
  data: RitualsData;
}
const { locale, data } = Astro.props;
const t = useTranslations(locale);
const base = localePath(locale);
const uk = locale === "uk";
const items = present(data.items);
---

<section id="rituals" class="bg-cream py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-4xl text-ink md:text-5xl" data-tina-field={tinaField(data)}>{t("rituals.title")}</h2>
      <p class="mt-4 text-ink/65">{t("rituals.subtitle")}</p>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-2" data-tina-field={tinaField(data)}>
      {
        items.map((r) => {
          const name = uk ? r.nameUk : r.nameEn;
          const includesField = uk ? "includesUk" : "includesEn";
          const includes = (r[includesField] ?? []).filter((s): s is string => !!s);
          return (
            <article
              class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-cream-deep"
              data-tina-field={tinaField(r)}
            >
              <img
                src={mediaSrc(r.image, Astro.isPrerendered)}
                alt={`${name} — ${r.duration} ${t("services.min")} · Abadzhi Wellness Space, Dublin`}
                class="aspect-[5/2] w-full object-cover object-top"
                loading="lazy"
                data-tina-field={tinaField(r, "image")}
              />
              <div class="p-7">
                <div class="flex items-baseline justify-between gap-4">
                  <h3
                    class="font-serif text-2xl text-ink"
                    data-tina-field={tinaField(r, uk ? "nameUk" : "nameEn")}
                  >
                    {name}
                  </h3>
                  <span
                    class="shrink-0 font-serif text-xl text-sage-deep"
                    data-tina-field={tinaField(r, "price")}
                  >
                    €{r.price}
                  </span>
                </div>
                <p class="mt-1 text-sm uppercase tracking-wider text-sage">
                  <span data-tina-field={tinaField(r, "duration")}>
                    {r.duration} {t("services.min")}
                  </span>
                  {(uk ? r.subtitleUk : r.subtitleEn) && (
                    <span data-tina-field={tinaField(r, uk ? "subtitleUk" : "subtitleEn")}>
                      · {uk ? r.subtitleUk : r.subtitleEn}
                    </span>
                  )}
                </p>
                <p class="mt-4 text-ink/75" data-tina-field={tinaField(r, uk ? "descUk" : "descEn")}>
                  {uk ? r.descUk : r.descEn}
                </p>

                {includes.length > 0 && (
                  <>
                    <p class="mt-6 text-sm font-medium uppercase tracking-wider text-sage-deep">
                      {t("rituals.includes")}
                    </p>
                    <ul class="mt-3 space-y-2" data-tina-field={tinaField(r, includesField)}>
                      {includes.map((item, i) => (
                        <li
                          class="flex items-start gap-2 text-sm text-ink/75"
                          data-tina-field={tinaField(r, includesField, i)}
                        >
                          <Icon name="lucide:leaf" class="mt-0.5 h-4 w-4 shrink-0 text-sage" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}

                <a
                  href={`${base}/#contact`}
                  class="mt-7 inline-flex items-center justify-center rounded-full bg-sage-deep px-5 py-2.5 text-sm font-medium text-cream transition-colors hover:bg-sage"
                >
                  {t("rituals.book")}
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
