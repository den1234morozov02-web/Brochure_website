---
import { tinaField } from "@tinacms/astro/tina-field";
import { useTranslations } from "../i18n/ui";
import { type Locale } from "../data/site";
import type { AboutData } from "../lib/tina/data";

interface Props {
  locale: Locale;
  data: AboutData;
}
const { locale, data } = Astro.props;
const t = useTranslations(locale);
const bodyField = locale === "uk" ? "bodyUk" : "bodyEn";
---

<section id="about" class="bg-cream py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 md:grid-cols-2 md:gap-16">
    <img
      src={data.photo ?? "/media/about-owner.jpg"}
      alt={`${data.name} — holistic massage & aromatherapy therapist at Abadzhi Wellness Space, Dublin 2`}
      class="mx-auto w-full max-w-md rounded-2xl object-cover shadow-md md:max-w-none"
      width="1422"
      height="1106"
      loading="lazy"
      data-tina-field={tinaField(data, "photo")}
    />

    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-sage">{t("about.title")}</p>
      <h2 class="mt-2 font-serif text-4xl text-ink md:text-5xl" data-tina-field={tinaField(data, "name")}>
        {data.name}
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-ink/75" data-tina-field={tinaField(data, bodyField)}>
        {data[bodyField]}
      </p>
    </div>
  </div>
</section>
