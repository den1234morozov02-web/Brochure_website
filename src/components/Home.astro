---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import About from "./About.astro";
import Services from "./Services.astro";
import Rituals from "./Rituals.astro";
import Pricing from "./Pricing.astro";
import Faq from "./Faq.astro";
import Certificates from "./Certificates.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import { type Locale } from "../data/site";
import {
  getAbout,
  getContacts,
  getFaq,
  getGeneral,
  getQualifications,
  getRituals,
  getServices,
  priceRows,
} from "../lib/tina/data";
import { islands } from "../lib/tina/islands";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const [general, about, qualifications, services, rituals, faq, contacts] = await Promise.all([
  getGeneral(),
  getAbout(),
  getQualifications(),
  getServices(),
  getRituals(),
  getFaq(),
  getContacts(),
]);
const rows = priceRows(services.data.services, rituals.data.rituals);
const c = contacts.data.contacts;
const params = { locale };
---

<Layout locale={locale} contacts={c} rows={rows}>
  <Header locale={locale} />
  <main>
    <TinaIsland name="hero" wrapper={islands.hero.wrapper} params={params} primary>
      <Hero locale={locale} general={general.data.general} contacts={c} />
    </TinaIsland>
    <TinaIsland name="about" wrapper={islands.about.wrapper} params={params}>
      <About locale={locale} data={about.data.about} />
    </TinaIsland>
    <TinaIsland name="qualifications" wrapper={islands.qualifications.wrapper} params={params}>
      <Certificates locale={locale} data={qualifications.data.qualifications} />
    </TinaIsland>
    <TinaIsland name="services" wrapper={islands.services.wrapper} params={params}>
      <Services locale={locale} data={services.data.services} />
    </TinaIsland>
    <TinaIsland name="rituals" wrapper={islands.rituals.wrapper} params={params}>
      <Rituals locale={locale} data={rituals.data.rituals} />
    </TinaIsland>
    <TinaIsland name="pricing" wrapper={islands.pricing.wrapper} params={params}>
      <Pricing locale={locale} rows={rows} />
    </TinaIsland>
    <TinaIsland name="faq" wrapper={islands.faq.wrapper} params={params}>
      <Faq locale={locale} data={faq.data.faq} />
    </TinaIsland>
    <TinaIsland name="contact" wrapper={islands.contact.wrapper} params={params}>
      <Contact locale={locale} contacts={c} rows={rows} />
    </TinaIsland>
  </main>
  <TinaIsland name="footer" wrapper={islands.footer.wrapper} params={params}>
    <Footer locale={locale} contacts={c} />
  </TinaIsland>
</Layout>

<script>
  import "../scripts/forms.ts";
</script>
