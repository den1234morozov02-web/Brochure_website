---
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import About from "./About.astro";
import Services from "./Services.astro";
import Rituals from "./Rituals.astro";
import Pricing from "./Pricing.astro";
import Faq from "./Faq.astro";
import Certificates from "./Certificates.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import { type Locale } from "../data/site";
import { getAbout, getRituals, toRituals } from "../lib/tina/data";
import { islands } from "../lib/tina/islands";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const [about, ritualsRes] = await Promise.all([getAbout(), getRituals()]);
const rituals = toRituals(ritualsRes.data.rituals);
---

<Layout locale={locale} rituals={rituals}>
  <Header locale={locale} />
  <main>
    <Hero locale={locale} />
    <TinaIsland name="about" wrapper={islands.about.wrapper} params={{ locale }} primary>
      <About locale={locale} data={about.data.about} />
    </TinaIsland>
    <Certificates locale={locale} />
    <Services locale={locale} />
    <TinaIsland name="rituals" wrapper={islands.rituals.wrapper} params={{ locale }}>
      <Rituals locale={locale} data={ritualsRes.data.rituals} />
    </TinaIsland>
    <Pricing locale={locale} rituals={rituals} />
    <Faq locale={locale} />
    <Contact locale={locale} rituals={rituals} />
  </main>
  <Footer locale={locale} />
</Layout>

<script>
  import "../scripts/forms.ts";
</script>
