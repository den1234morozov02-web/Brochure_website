---
import { useTranslations } from "../i18n/ui";
import { type Locale } from "../data/site";
import type { PriceRow } from "../lib/tina/data";

interface Props {
  locale: Locale;
  rows: PriceRow[];
}
// Прайс не редактируется напрямую: собирается из услуг и ритуалов.
const { locale, rows } = Astro.props;
const t = useTranslations(locale);
---

<section id="pricing" class="bg-ink py-20 text-cream md:py-28">
  <div class="mx-auto max-w-3xl px-4">
    <h2 class="text-center font-serif text-4xl text-gold-soft md:text-5xl">{t("pricing.title")}</h2>

    <div class="mt-12 divide-y divide-cream/10">
      {
        rows.map((row) => (
          <div class="flex items-baseline justify-between gap-4 py-4">
            <span class="min-w-0 font-serif text-xl text-cream">{row.name[locale]}</span>
            <span class="flex shrink-0 items-baseline gap-4">
              <span class="w-16 whitespace-nowrap text-right text-base text-cream/60 sm:w-20">
                {row.duration} {t("services.min")}
              </span>
              <span class="w-16 text-right font-serif text-xl text-gold-soft">
                €{row.price}
                {row.note?.[locale] && <span class="block text-xs text-cream/50">{row.note[locale]}</span>}
              </span>
            </span>
          </div>
        ))
      }
    </div>

    <p class="mt-10 text-center text-base italic leading-relaxed text-cream/60">
      {t("pricing.note")}
    </p>
  </div>
</section>
