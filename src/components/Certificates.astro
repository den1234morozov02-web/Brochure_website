---
import { Icon } from "astro-icon/components";
import { tinaField } from "@tinacms/astro/tina-field";
import { useTranslations } from "../i18n/ui";
import { type Locale } from "../data/site";
import { present, type QualificationsData } from "../lib/tina/data";

interface Props {
  locale: Locale;
  data: QualificationsData;
}
const { locale, data } = Astro.props;
const t = useTranslations(locale);
const uk = locale === "uk";
const membership = data.membership;
const certificates = present(data.certificates);
---

<section id="qualifications" class="bg-ink py-20 text-cream md:py-28">
  <div class="mx-auto max-w-6xl px-4">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-serif text-4xl text-gold-soft md:text-5xl" data-tina-field={tinaField(data)}>{t("cert.title")}</h2>
      <p class="mt-4 text-cream/70">{t("cert.subtitle")}</p>
    </div>

    <!-- Главный сертификат: членство IMTA — всегда на виду -->
    {
      membership && (
        <div
          class="mx-auto mt-10 max-w-3xl rounded-2xl bg-gold/10 p-5 ring-1 ring-gold/30 sm:p-7"
          data-tina-field={tinaField(data, "membership")}
        >
          <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-center">
            <button
              type="button"
              class="cert-thumb group shrink-0 overflow-hidden rounded-lg bg-white shadow-lg ring-1 ring-gold/30 transition hover:ring-gold/60"
              data-cert-src={membership.image}
              data-cert-alt={membership.org}
              aria-label={`${t("cert.view")}: ${membership.org}`}
              data-tina-field={tinaField(membership, "image")}
            >
              <img
                src={membership.image}
                alt={membership.org}
                class="h-64 w-auto object-contain transition group-hover:scale-[1.03]"
              />
            </button>
            <div class="text-center sm:text-left">
              <span
                class="inline-flex items-center gap-2 rounded-full bg-gold/15 px-3 py-1 text-xs font-medium uppercase tracking-wider text-gold-soft"
                data-tina-field={tinaField(membership, uk ? "statusUk" : "statusEn")}
              >
                <Icon name="lucide:badge-check" class="h-4 w-4" />
                {uk ? membership.statusUk : membership.statusEn}
              </span>
              <p class="mt-3 font-serif text-2xl text-cream" data-tina-field={tinaField(membership, "org")}>
                {membership.org}
              </p>
              <p class="mt-2 text-sm text-cream/70">
                {t("cert.member")}: {uk ? membership.statusUk : membership.statusEn}
              </p>
              <p class="text-sm text-cream/70" data-tina-field={tinaField(membership, "number")}>
                No. {membership.number}
              </p>
              <p class="text-sm text-cream/70" data-tina-field={tinaField(membership, "validUntil")}>
                {t("cert.validUntil")}: {membership.validUntil}
              </p>
            </div>
          </div>
        </div>
      )
    }

    <!-- Список квалификаций -->
    <ul
      class="mx-auto mt-10 grid max-w-4xl gap-x-8 gap-y-3 sm:grid-cols-2"
      data-tina-field={tinaField(data)}
    >
      {
        certificates.map((c) => (
          <li class="flex items-start gap-2 text-cream/85" data-tina-field={tinaField(c)}>
            <Icon name="lucide:award" class="mt-1 h-4 w-4 shrink-0 text-gold" />
            <span>
              <span data-tina-field={tinaField(c, uk ? "titleUk" : "titleEn")}>{uk ? c.titleUk : c.titleEn}</span>
              <span class="text-cream/45" data-tina-field={tinaField(c, "issuer")}> · {c.issuer}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <!-- Кнопка-тоггл галереи (сертификаты по умолчанию скрыты) -->
    <div class="mt-10 text-center">
      <button
        id="cert-gallery-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="cert-gallery"
        class="inline-flex items-center gap-2 rounded-full border border-gold/50 px-6 py-2.5 text-gold-soft transition-colors hover:bg-gold hover:text-ink"
        data-label-show={t("cert.toggle")}
        data-label-hide={t("cert.hide")}
      >
        <Icon name="lucide:images" class="h-5 w-5" />
        <span data-toggle-label>{t("cert.toggle")}</span>
        <Icon id="cert-chevron" name="lucide:chevron-down" class="h-4 w-4 transition-transform" />
      </button>
    </div>

    <!-- Галерея сертификатов (клик — увеличение) -->
    <div id="cert-gallery" class="hidden">
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        {
          certificates.map((c) => (
            <button
              type="button"
              class="cert-thumb group overflow-hidden rounded-lg bg-white/5 ring-1 ring-cream/10 transition hover:ring-gold/50"
              data-cert-src={c.image}
              data-cert-alt={uk ? c.titleUk : c.titleEn}
              aria-label={`${t("cert.view")}: ${uk ? c.titleUk : c.titleEn}`}
              data-tina-field={tinaField(c, "image")}
            >
              <img
                src={c.image}
                alt={uk ? c.titleUk : c.titleEn}
                loading="lazy"
                class="aspect-[3/4] w-full object-cover transition group-hover:scale-105"
              />
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Лайтбокс -->
  <div
    id="cert-lightbox"
    class="fixed inset-0 z-[60] hidden items-center justify-center bg-ink/90 p-4 backdrop-blur"
    role="dialog"
    aria-modal="true"
  >
    <button
      id="cert-close"
      class="absolute right-4 top-4 rounded-full bg-cream/10 p-2 text-cream hover:bg-cream/20"
      aria-label="Close"
    >
      <Icon name="lucide:x" class="h-6 w-6" />
    </button>
    <img id="cert-full" src="" alt="" class="max-h-[90vh] max-w-full rounded-lg object-contain shadow-2xl" />
  </div>
</section>

<script>
  // Обработчики вешаем на document (делегирование): в редакторе Tina секция
  // перерисовывается целиком, и обработчики на самих элементах бы терялись.
  const inEditor = window.self !== window.top;

  function setGallery(show: boolean) {
    const gallery = document.getElementById("cert-gallery");
    const toggle = document.getElementById("cert-gallery-toggle");
    if (!gallery || !toggle) return;
    gallery.classList.toggle("hidden", !show);
    toggle.setAttribute("aria-expanded", String(show));
    document.getElementById("cert-chevron")?.classList.toggle("rotate-180", show);
    const label = toggle.querySelector<HTMLElement>("[data-toggle-label]");
    if (label) {
      label.textContent = show ? toggle.dataset.labelHide ?? "" : toggle.dataset.labelShow ?? "";
    }
  }

  function openLightbox(src: string, alt: string) {
    const box = document.getElementById("cert-lightbox");
    const full = document.getElementById("cert-full") as HTMLImageElement | null;
    if (!box || !full) return;
    full.src = src;
    full.alt = alt;
    box.classList.remove("hidden");
    box.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function hideLightbox() {
    const box = document.getElementById("cert-lightbox");
    if (!box) return;
    box.classList.add("hidden");
    box.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    if (target.closest("#cert-gallery-toggle")) {
      setGallery(document.getElementById("cert-gallery")?.classList.contains("hidden") ?? false);
      return;
    }
    // Открытие галереи кликом по пункту "Qualifications" в навбаре
    if (target.closest('a[href$="#qualifications"]')) {
      setGallery(true);
      return;
    }
    // В редакторе клик по картинке выбирает поле, лайтбокс не открываем
    const thumb = target.closest<HTMLElement>(".cert-thumb");
    if (thumb && !inEditor) {
      openLightbox(thumb.dataset.certSrc ?? "", thumb.dataset.certAlt ?? "");
      return;
    }
    if (target.closest("#cert-close") || target.id === "cert-lightbox") hideLightbox();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") hideLightbox();
  });

  // В редакторе галерея всегда раскрыта, чтобы было видно, какие картинки менять.
  if (inEditor) {
    const style = document.createElement("style");
    style.textContent = "#cert-gallery.hidden{display:block}";
    document.head.append(style);
  }
</script>
